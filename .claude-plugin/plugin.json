{
  "name": "dart-stack",
  "displayName": "Dart Stack",
  "version": "0.1.0",
  "description": "Unofficial bundle of the official agent skills for Flutter, Dart, Serverpod, Jaspr, and Flutter Scene, synced daily from upstream, plus the Dart MCP server.",
  "author": {
    "name": "RealYoungk",
    "url": "https://github.com/RealYoungk"
  },
  "homepage": "https://github.com/RealYoungk/dart-stack",
  "repository": "https://github.com/RealYoungk/dart-stack",
  "keywords": [
    "dart",
    "flutter",
    "serverpod",
    "jaspr",
    "flutter_scene"
  ],
  "mcpServers": {
    "dart-mcp-server": {
      "command": "dart",
      "args": [
        "mcp-server"
      ],
      "env": {
        "AGENT_PLUGIN": "claude-code"
      }
    }
  }
}
